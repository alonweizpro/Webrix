{
  "name": "webrix-browser",
  "productName": "Webrix",
  "version": "1.0.2",
  "description": "Webrix – דפדפן גיימינג מהיר עם Control Core, מצב גיימינג והתאמה אישית מלאה",
  "main": "main.js",
  "author": "alonweizpro",
  "license": "MIT",
  "repository": "https://github.com/alonweizpro/Webrix",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.webrix.browser",
    "productName": "Webrix",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Webrix-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Webrix",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alonweizpro",
        "repo": "Webrix",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "electronLanguages": [
      "he",
      "en-US"
    ],
    "asar": true
  }
}
